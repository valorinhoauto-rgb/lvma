rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Unique Nicknames Registry: one unique document per normalized nickname
    match /nicknames/{nicknameLower} {
      allow read: if isValidId(nicknameLower);
      allow create: if isValidId(nicknameLower);
      allow update: if isValidId(nicknameLower);
    }

    // User profiles & friends
    match /users/{userId} {
      allow get, list: if isValidId(userId);
      allow create, update: if isValidId(userId);
      allow delete: if false;

      // Subcollection for friends
      match /friends/{friendId} {
        allow read, write: if isValidId(userId) && isValidId(friendId);
      }

      // Subcollection for game history
      match /gameHistory/{historyId} {
        allow read, write: if isValidId(userId);
      }
    }

    // Rooms (for multiplayer cloud persistence and real-time sync across all players)
    match /rooms/{roomId} {
      allow read, write: if isValidId(roomId);
    }
  }
}
