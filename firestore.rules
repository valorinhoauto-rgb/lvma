rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Subcollection for game history
      match /gameHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Rooms (for multiplayer cloud persistence / Netlify sync)
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if isSignedIn() || resource == null;
      allow delete: if false;
    }
  }
}
